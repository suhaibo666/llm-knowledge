{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/native_backend_environment.schema.json",
  "title": "Native backend capability and acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at_utc",
    "host",
    "runtime",
    "capabilities",
    "statuses"
  ],
  "properties": {
    "schema_version": {
      "const": "native-backend-evidence/v1"
    },
    "artifact_type": {
      "enum": [
        "local_capability_diagnostic",
        "native_acceptance_result"
      ]
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "statuses": {
      "$ref": "#/$defs/statuses"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "acceptance_results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_native": {
          "$ref": "#/$defs/cpuNativeResult"
        },
        "cuda_triton": {
          "$ref": "#/$defs/cudaTritonResult"
        }
      },
      "minProperties": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "local_capability_diagnostic"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "acceptance_results"
              ]
            },
            {
              "required": [
                "producer"
              ]
            }
          ]
        },
        "properties": {
          "statuses": {
            "type": "object",
            "properties": {
              "cpu_native": {
                "enum": [
                  "BLOCKED",
                  "FAIL",
                  "NOT_RUN"
                ]
              },
              "cuda_triton": {
                "enum": [
                  "BLOCKED",
                  "FAIL",
                  "NOT_RUN"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "native_acceptance_result"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "required": [
          "producer",
          "acceptance_results"
        ],
        "anyOf": [
          {
            "properties": {
              "statuses": {
                "properties": {
                  "cpu_native": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "cpu_native"
                ]
              }
            }
          },
          {
            "properties": {
              "statuses": {
                "properties": {
                  "cuda_triton": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "cuda_triton"
                ]
              }
            }
          }
        ],
        "properties": {
          "runtime": {
            "properties": {
              "torch_version": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "torch_git_version": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "statuses": {
            "properties": {
              "cpu_native": {
                "const": "PASS"
              }
            },
            "required": [
              "cpu_native"
            ]
          }
        },
        "required": [
          "statuses"
        ]
      },
      "then": {
        "required": [
          "acceptance_results"
        ],
        "properties": {
          "artifact_type": {
            "const": "native_acceptance_result"
          },
          "capabilities": {
            "properties": {
              "cpu_cpp": {
                "properties": {
                  "available": {
                    "const": true
                  }
                }
              }
            }
          },
          "acceptance_results": {
            "required": [
              "cpu_native"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "statuses": {
            "properties": {
              "cuda_triton": {
                "const": "PASS"
              }
            },
            "required": [
              "cuda_triton"
            ]
          }
        },
        "required": [
          "statuses"
        ]
      },
      "then": {
        "required": [
          "acceptance_results"
        ],
        "properties": {
          "artifact_type": {
            "const": "native_acceptance_result"
          },
          "capabilities": {
            "properties": {
              "cuda": {
                "properties": {
                  "available": {
                    "const": true
                  }
                }
              },
              "triton": {
                "properties": {
                  "available": {
                    "const": true
                  }
                }
              }
            }
          },
          "acceptance_results": {
            "required": [
              "cuda_triton"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "language"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "language": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "os",
        "os_version",
        "architecture"
      ],
      "properties": {
        "hostname": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "os_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "python_executable",
        "torch_version",
        "torch_git_version"
      ],
      "properties": {
        "python_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_executable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "torch_version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "torch_git_version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        }
      }
    },
    "cpuCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "compiler_path",
        "compiler_version",
        "detail"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "compiler_path": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "compiler_version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "properties": {
              "compiler_path": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "compiler_version": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "cudaCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "device_count",
        "detail"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "device_count": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "properties": {
              "device_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "tritonCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "version",
        "detail"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_cpp",
        "cuda",
        "triton"
      ],
      "properties": {
        "cpu_cpp": {
          "$ref": "#/$defs/cpuCapability"
        },
        "cuda": {
          "$ref": "#/$defs/cudaCapability"
        },
        "triton": {
          "$ref": "#/$defs/tritonCapability"
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_native",
        "cuda_triton"
      ],
      "properties": {
        "cpu_native": {
          "$ref": "#/$defs/status"
        },
        "cuda_triton": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_version",
        "module_sha256",
        "command",
        "target"
      ],
      "properties": {
        "id": {
          "const": "native_backend_contract.py"
        },
        "contract_version": {
          "const": "native-backend-evidence/v1"
        },
        "module_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "target": {
          "enum": [
            "cpu",
            "cuda"
          ]
        }
      }
    },
    "tensorSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dtype",
        "shape",
        "numel",
        "sha256"
      ],
      "properties": {
        "dtype": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "numel": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "timingStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "min",
        "median",
        "mean",
        "p95",
        "max"
      ],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mean": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p95": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "benchmarkRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "entry_point",
        "warmup",
        "iterations",
        "timings_ms",
        "input_summary",
        "eager_output_summary",
        "native_output_summary",
        "numerical_comparison"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "kind": {
          "enum": [
            "pointwise",
            "reduction"
          ]
        },
        "entry_point": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "warmup": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "timings_ms": {
          "$ref": "#/$defs/timingStats"
        },
        "input_summary": {
          "$ref": "#/$defs/tensorSummary"
        },
        "eager_output_summary": {
          "$ref": "#/$defs/tensorSummary"
        },
        "native_output_summary": {
          "$ref": "#/$defs/tensorSummary"
        },
        "numerical_comparison": {
          "$ref": "#/$defs/numericalComparison"
        }
      }
    },
    "numericalComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference",
        "allclose",
        "rtol",
        "atol",
        "max_abs_error",
        "max_rel_error",
        "reference_max_abs"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "reference": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "allclose": {
          "const": true
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        },
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_error": {
          "type": "number",
          "minimum": 0
        },
        "max_rel_error": {
          "type": "number",
          "minimum": 0
        },
        "reference_max_abs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "cpuEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "python_version",
        "torch_version",
        "torch_git_version",
        "backend"
      ],
      "properties": {
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "torch_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "torch_git_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "backend": {
          "const": "contract_native_cpp"
        }
      }
    },
    "cpuNativeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "compiler",
        "generated_source",
        "compile",
        "load",
        "execute",
        "numerical_comparison",
        "workloads",
        "environment"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "version": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "generated_source": {
          "$ref": "#/$defs/sourceReference"
        },
        "compile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "command",
            "returncode",
            "source_argument",
            "output_argument",
            "stdout_log",
            "stderr_log",
            "output_artifact"
          ],
          "properties": {
            "status": {
              "const": "PASS"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "returncode": {
              "const": 0
            },
            "source_argument": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "output_argument": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "stdout_log": {
              "$ref": "#/$defs/artifactReference"
            },
            "stderr_log": {
              "$ref": "#/$defs/artifactReference"
            },
            "output_artifact": {
              "$ref": "#/$defs/artifactReference"
            }
          }
        },
        "load": {
          "$ref": "#/$defs/cpuLoadStage"
        },
        "execute": {
          "$ref": "#/$defs/executionStage"
        },
        "numerical_comparison": {
          "$ref": "#/$defs/numericalComparison"
        },
        "workloads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointwise",
            "reduction"
          ],
          "properties": {
            "pointwise": {
              "$ref": "#/$defs/benchmarkRecord"
            },
            "reduction": {
              "$ref": "#/$defs/benchmarkRecord"
            }
          }
        },
        "environment": {
          "$ref": "#/$defs/cpuEnvironment"
        }
      }
    },
    "passStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        }
      }
    },
    "cpuLoadStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "artifact_path",
        "entry_points"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "method": {
          "const": "ctypes.CDLL"
        },
        "artifact_path": {
          "$ref": "#/$defs/relativePath"
        },
        "entry_points": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "executionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "returncode",
        "calls"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "returncode": {
          "const": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "launcher": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "candidateParameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      }
    },
    "tritonCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters",
        "timings_ms"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "parameters": {
          "$ref": "#/$defs/candidateParameters"
        },
        "timings_ms": {
          "$ref": "#/$defs/timingStats"
        }
      }
    },
    "cudaEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "python_version",
        "torch_version",
        "torch_git_version",
        "cuda_runtime_version",
        "driver_version",
        "triton_version",
        "backend"
      ],
      "properties": {
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "torch_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "torch_git_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cuda_runtime_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "driver_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "triton_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "backend": {
          "const": "contract_triton"
        }
      }
    },
    "cudaTritonResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "device",
        "generated_source",
        "benchmark",
        "cache_artifact",
        "execution",
        "input_summary",
        "eager_output_summary",
        "native_output_summary",
        "numerical_comparison",
        "allocator",
        "environment"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "index",
            "compute_capability",
            "driver_version",
            "cuda_runtime_version",
            "triton_version"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "compute_capability": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "driver_version": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "cuda_runtime_version": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "triton_version": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "generated_source": {
          "$ref": "#/$defs/sourceReference"
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warmup",
            "iterations",
            "synchronization",
            "candidates",
            "winner"
          ],
          "properties": {
            "warmup": {
              "type": "integer",
              "minimum": 1
            },
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "synchronization": {
              "const": "torch.cuda.synchronize"
            },
            "candidates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/tritonCandidate"
              }
            },
            "winner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_name",
                "metric",
                "timing_ms"
              ],
              "properties": {
                "candidate_name": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "metric": {
                  "const": "median_ms"
                },
                "timing_ms": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "cache_artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "execution": {
          "$ref": "#/$defs/executionStage"
        },
        "input_summary": {
          "$ref": "#/$defs/tensorSummary"
        },
        "eager_output_summary": {
          "$ref": "#/$defs/tensorSummary"
        },
        "native_output_summary": {
          "$ref": "#/$defs/tensorSummary"
        },
        "numerical_comparison": {
          "$ref": "#/$defs/numericalComparison"
        },
        "allocator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_memory_allocated_bytes",
            "max_memory_reserved_bytes",
            "reset_peak_api",
            "history_enabled",
            "memory_snapshot",
            "memory_trace"
          ],
          "properties": {
            "max_memory_allocated_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_memory_reserved_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "reset_peak_api": {
              "const": "torch.cuda.reset_peak_memory_stats"
            },
            "history_enabled": {
              "const": true
            },
            "memory_snapshot": {
              "$ref": "#/$defs/artifactReference"
            },
            "memory_trace": {
              "$ref": "#/$defs/artifactReference"
            }
          }
        },
        "environment": {
          "$ref": "#/$defs/cudaEnvironment"
        }
      }
    }
  }
}
