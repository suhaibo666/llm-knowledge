      "before": "    const usesCustomOgImage = ctx.cfg.plugins.emitters.some(\n      (e) => e.name === CustomOgImagesEmitterName,\n    )\n    const ogImageDefaultPath = `https://${cfg.baseUrl}/static/og-image.png`",
      "after": "    const usesCustomOgImage = true\n    const ogImageDefaultPath = \"\""
    },
    {
      "file": "quartz/plugins/loader/config-loader.ts",
      "before": "  let footer: QuartzComponent | undefined",
      "after": "  const EmptyFooter: QuartzComponent = () => null\n  let footer: QuartzComponent = EmptyFooter"
